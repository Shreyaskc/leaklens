__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.coverage
build/
dist/
.idea/
.DS_Store

# LaTeX build byproducts (paper/main.pdf, main.tex, and main.bbl are the
# tracked deliverables; these are regenerated by pdflatex/bibtex).
paper/*.aux
paper/*.blg
paper/*.log
paper/*.out
paper/missfont.log

# Anonymized ARR/peer-review submission — must NEVER be pushed to this
# public, non-anonymous repo. Linking "Anonymous ACL submission" back to
# this identified repository would defeat double-blind review entirely.
# Keep local-only; upload directly to OpenReview instead.
paper/arr/

# Phase 3 calibration fine-tune outputs: LoRA adapter weights and derived
# training data are large-ish and fully regenerable from
# scripts/run_calibration.py, so they're excluded -- but
# calibration_runs/calibration_results.json itself (the actual finding,
# a few KB) is deliberately NOT excluded and should be committed.
calibration_runs/adapter_*/
calibration_runs/*_data/

# The registry's raw audit run outputs -- large, regenerable, published
# separately (HF / registry site) rather than committed here.
registry_data/
